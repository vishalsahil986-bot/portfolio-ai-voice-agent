# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Gemini
GEMINI_API_KEY1=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GEMINI_API_KEY4=
GEMINI_MODEL=gemini-3.1-flash-lite

# Whisper
WHISPER_MODEL_SIZE=Systran/faster-distil-whisper-medium.en
WHISPER_DEVICE=cpu

# ElevenLabs (key + voice rotate together)
ELEVENLABS_API_KEY1=
ELEVENLABS_VOICE_ID1=
ELEVENLABS_API_KEY2=
ELEVENLABS_VOICE_ID2=
ELEVENLABS_API_KEY3=
ELEVENLABS_VOICE_ID3=
ELEVENLABS_API_KEY4=
ELEVENLABS_VOICE_ID4=
ELEVENLABS_API_KEY5=
ELEVENLABS_VOICE_ID5=
ELEVENLABS_API_KEY6=
ELEVENLABS_VOICE_ID6=
ELEVENLABS_API_KEY7=
ELEVENLABS_VOICE_ID7=
ELEVENLABS_API_KEY8=
ELEVENLABS_VOICE_ID8=
ELEVENLABS_MODEL_ID=eleven_turbo_v2

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=voice-agent
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# HuggingFace
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RAG_TOP_K=3

# MongoDB
MONGODB_URI=
MONGODB_DB_NAME=ai_voice_agent
SESSION_EXPIRY_HOURS=2
MEMORY_RAW_TURNS_LIMIT=6